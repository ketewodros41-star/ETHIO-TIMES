# =====================================================================
# ETHIOTIMES — Environment configuration (EXAMPLE — no real secrets)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
ENVIRONMENT=local                     # local | staging | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------
# Database — Supabase PostgreSQL (use the POOLER connection string)
# Format (Supabase transaction pooler, port 6543):
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For local docker-compose Postgres you can instead use:
#   postgresql+psycopg://ethiotimes:ethiotimes@localhost:5432/ethiotimes
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional: a direct (non-pooler) connection used ONLY for running migrations,
# because some Supabase pooler modes do not support certain DDL / advisory locks.
# Format (direct, port 5432):
#   postgresql+psycopg://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_MIGRATION_URL=

# ---------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------
# Auth (Phase 1 scaffolding)
# ---------------------------------------------------------------------
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------
# CORS — comma-separated list of allowed origins for the dashboard
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Ingestion tuning
# ---------------------------------------------------------------------
DEFAULT_CRAWL_FREQUENCY_MINUTES=30
INGEST_HTTP_TIMEOUT_SECONDS=20
INGEST_USER_AGENT=ETHIOTIMES-Bot/1.0 (+https://ethiotimes.example)

# ---------------------------------------------------------------------
# AI providers (Gemini) — Phase 2 intelligence pipeline
# Provide GEMINI_API_KEY at LOCAL RUNTIME only; never commit it. Without a key
# the pipeline still runs relevance + analysis via deterministic fallbacks, but
# embeddings and event clustering (which require the model) are skipped.
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# gemini-embedding-001 supports 768/1536/3072; we use 1536 (L2-normalized).
# Changing this requires a matching pgvector column migration.
EMBEDDING_DIM=1536
GEMINI_REQUEST_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_DELAY_SECONDS=2.0
GEMINI_TEMPERATURE=0.2

# ---------------------------------------------------------------------
# Intelligence pipeline thresholds
# ---------------------------------------------------------------------
RELEVANCE_THRESHOLD=70              # score >= threshold => relevant
RELEVANCE_BORDERLINE_MARGIN=15     # [threshold-margin, threshold) => borderline
CLUSTER_DUPLICATE_THRESHOLD=0.90   # cosine composite >= => duplicate
CLUSTER_SAME_EVENT_THRESHOLD=0.80  # possible same event (Gemini confirms)
CLUSTER_RELATED_THRESHOLD=0.70     # related coverage
CLUSTER_TIME_WINDOW_HOURS=72       # only cluster within this window
CLUSTER_CANDIDATE_LIMIT=25         # max neighbors considered per article
PIPELINE_MAX_ATTEMPTS=5            # attempts before dead-letter

# ---------------------------------------------------------------------
# Tests — isolated database used by the backend test suite
# ---------------------------------------------------------------------
TEST_DATABASE_URL=postgresql+psycopg://ethiotimes:ethiotimes@localhost:5432/ethiotimes_test

# ---------------------------------------------------------------------
# Frontend (Next.js) — public runtime config
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
