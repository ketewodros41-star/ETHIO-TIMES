# =====================================================================
# ETHIOTIMES — Environment configuration (EXAMPLE — no real secrets)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
ENVIRONMENT=local                     # local | staging | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------
# Database — Supabase PostgreSQL (use the POOLER connection string)
# Format (Supabase transaction pooler, port 6543):
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For local docker-compose Postgres you can instead use:
#   postgresql+psycopg://ethiotimes:ethiotimes@localhost:5432/ethiotimes
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional: a direct (non-pooler) connection used ONLY for running migrations,
# because some Supabase pooler modes do not support certain DDL / advisory locks.
# Format (direct, port 5432):
#   postgresql+psycopg://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_MIGRATION_URL=

# ---------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------------------------------------------------
# Auth (Phase 1 scaffolding)
# ---------------------------------------------------------------------
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------
# CORS — comma-separated list of allowed origins for the dashboard
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Ingestion tuning
# ---------------------------------------------------------------------
DEFAULT_CRAWL_FREQUENCY_MINUTES=30
INGEST_HTTP_TIMEOUT_SECONDS=20
INGEST_USER_AGENT=ETHIOTIMES-Bot/1.0 (+https://ethiotimes.example)

# ---------------------------------------------------------------------
# AI providers (Phase 1: abstractions/stubs only — keys optional for later)
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-pro
GEMINI_IMAGE_MODEL=imagen-3.0

# ---------------------------------------------------------------------
# Frontend (Next.js) — public runtime config
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
